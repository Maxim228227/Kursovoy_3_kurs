<Window x:Class="Kursovoy.AddTeacherForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление учителя" Height="400" Width="400">
    <Grid>
        <Label Content="ФИО:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox Name="FullNameTextBox" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="ID Должности:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
        <TextBox Name="PositionIDTextBox" HorizontalAlignment="Left" Margin="150,40,0,0" VerticalAlignment="Top" Width="200"/>

        <Button Content="Получить информацио о должностях" HorizontalAlignment="Left" Margin="150,90,0,0" VerticalAlignment="Top" Width="220" Click="GetPositionIDButton_Click"/>

        <Button Content="Добавить учителя" HorizontalAlignment="Left" Margin="150,120,0,0" VerticalAlignment="Top" Width="220" Click="AddTeacherButton_Click"/>
    </Grid>
</Window>