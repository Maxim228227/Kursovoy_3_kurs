<Window x:Class="Kursovoy.EditStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование студента" Height="590" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="UserID:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="UserIDTextBox" Grid.Row="0" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Имя:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="FirstNameTextBox" Grid.Row="1" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Фамилия:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="LastNameTextBox" Grid.Row="2" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Группа:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="GrupaTextBox" Grid.Row="3" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Телефон:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="PhoneTextBox" Grid.Row="4" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Email:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="EmailTextBox" Grid.Row="5" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Специальность:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="MajorTextBox" Grid.Row="6" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Адрес:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="AddressTextBox" Grid.Row="7" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Форма обучения:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="FormStudiesTextBox" Grid.Row="8" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Тип обучения (бюджет/платно):" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="TypeStudiesTextBox" Grid.Row="9" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="Иностранный студент (да/нет):" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="IsInternationalTextBox" Grid.Row="10" Grid.Column="1" Margin="10" Width="200"/>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Name="SaveButton" Content="Сохранить" Width="100" Height="30" Margin="5" Click="Save_Click"/>
            <Button Name="CancelButton" Content="Отмена" Width="100" Height="30" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
