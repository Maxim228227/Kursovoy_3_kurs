<Window x:Class="Kursovoy.EditTeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование учителя" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>


        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="ФИО учителя:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="FullNameTextBox" Grid.Row="0" Grid.Column="1" Margin="10" Width="200"/>

        <Label Content="ID должности:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="PositionIDTextBox" Grid.Row="1" Grid.Column="1" Margin="10" Width="200"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Name="SaveButton" Content="Сохранить" Width="110" Height="30" Margin="5" Click="Save_Click"/>
            <Button Name="CancelButton" Content="Отмена" Width="110" Height="30" Margin="5" Click="Cancel_Click"/>
            <Button Name="Information" Content="Должности" Width="110" Height="30" Margin="5" Click="GetPositionIDButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
