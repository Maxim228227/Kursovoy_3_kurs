<Window x:Class="KursovoyClient.BindCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Привязка карты" Height="300" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FAFAFA">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название карты:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="CardNameTextBox" Height="25" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Номер карты:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="CardNumberTextBox" Height="25" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Срок действия (MM/YY):" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="ExpiryDateTextBox" Height="25" FontSize="14" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="ОК" Width="80" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
