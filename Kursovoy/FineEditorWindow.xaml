<Window x:Class="Kursovoy.FineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование штрафа" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Фамилия:" Grid.Row="0" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="FirstNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Имя:" Grid.Row="1" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="LastNameTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="ФИО Учителя:" Grid.Row="2" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="TeacherTextBox" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Тип Услуги:" Grid.Row="3" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="ServiceTypeTextBox" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Сумма Штрафа:" Grid.Row="4" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="UnitPriceTextBox" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Скидка:" Grid.Row="5" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="DiscountTextBox" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Описание:" Grid.Row="6" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Дата Выдачи:" Grid.Row="7" Grid.Column="0" Margin="5"/>
        <TextBox x:Name="DateIssuedTextBox" Grid.Row="7" Grid.Column="1" Margin="5"/>

        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="5">
            <Button Content="Сохранить" Width="100" Margin="5" Click="Save_Click"/>
            <Button Content="Отменить" Width="100" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
