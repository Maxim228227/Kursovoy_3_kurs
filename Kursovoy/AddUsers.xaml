<Window x:Class="Kursovoy.AddUsers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление пользователя" Height="400" Width="400">
    <Grid>
        <Label Content="Логин:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox Name="LoginTextBox" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Пароль:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
        <TextBox Name="PaswordTextBox" HorizontalAlignment="Left" Margin="150,40,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Роль ID:" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top"/>
        <TextBox Name="RoleTextBox" HorizontalAlignment="Left" Margin="150,70,0,0" VerticalAlignment="Top" Width="200"/>

        <Button Content="Получить информацио о ролях" HorizontalAlignment="Left" Margin="150,100,0,0" VerticalAlignment="Top" Width="220" Click="GetPositionIDButton_Click"/>

        <Button Content="Добавить пользователя" HorizontalAlignment="Left" Margin="150,130,0,0" VerticalAlignment="Top" Width="220" Click="AddTeacherButton_Click"/>
    </Grid>
</Window>