<Window x:Class="Kursovoy.AddStudentForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление студента" Height="470" Width="450">
    <Grid>

        <Label Content="Имя:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
        <TextBox Name="FirstNameTextBox" HorizontalAlignment="Left" Margin="210,40,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Фамилия:" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top"/>
        <TextBox Name="LastNameTextBox" HorizontalAlignment="Left" Margin="210,70,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Дата рождения (ДД.ММ.ГГГГ):" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top"/>
        <TextBox Name="BirthDateTextBox" HorizontalAlignment="Left" Margin="210,100,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Дата зачисления (ДД.ММ.ГГГГ):" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
        <TextBox Name="EnrollmentDateTextBox" HorizontalAlignment="Left" Margin="210,130,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Специальность:" HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top"/>
        <TextBox Name="MajorTextBox" HorizontalAlignment="Left" Margin="210,160,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Email:" HorizontalAlignment="Left" Margin="10,190,0,0" VerticalAlignment="Top"/>
        <TextBox Name="EmailTextBox" HorizontalAlignment="Left" Margin="210,190,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Телефон:" HorizontalAlignment="Left" Margin="10,220,0,0" VerticalAlignment="Top"/>
        <TextBox Name="PhoneTextBox" HorizontalAlignment="Left" Margin="210,220,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Адрес:" HorizontalAlignment="Left" Margin="10,250,0,0" VerticalAlignment="Top"/>
        <TextBox Name="AddressTextBox" HorizontalAlignment="Left" Margin="210,250,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Форма обучения(Очная/Заочная):" HorizontalAlignment="Left" Margin="10,280,0,0" VerticalAlignment="Top"/>
        <TextBox Name="FormStudiesTextBox" HorizontalAlignment="Left" Margin="210,285,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Тип обучения бюджет ? (да/нет):" HorizontalAlignment="Left" Margin="10,310,0,0" VerticalAlignment="Top"/>
        <TextBox Name="TypeStudiesTextBox" HorizontalAlignment="Left" Margin="210,315,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="Группа:" HorizontalAlignment="Left" Margin="10,340,0,0" VerticalAlignment="Top"/>
        <TextBox Name="GroupTextBox" HorizontalAlignment="Left" Margin="210,347,0,0" VerticalAlignment="Top" Width="200"/>
        
        <Label Content="Иностранный (да/нет):" HorizontalAlignment="Left" Margin="10,370,0,0" VerticalAlignment="Top"/>
        <TextBox Name="IsInternationalTextBox" HorizontalAlignment="Left" Margin="210,377,0,0" VerticalAlignment="Top" Width="200"/>

        <Label Content="UserID (необязательно):" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox Name="UserIDTextBox" HorizontalAlignment="Left" Margin="210,10,0,0" VerticalAlignment="Top" Width="200"/>

        <Button Content="Добавить студента" HorizontalAlignment="Left" Margin="150,410,0,0" VerticalAlignment="Top" Width="200" Click="AddStudentButton_Click"/>
    </Grid>
</Window>