<Window x:Class="KursovoyClient.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система учёта и анализа оплаты" Height="500" Width="600" Background="#F5F5F5">
    <Grid Margin="20">
        <TextBlock x:Name="UserIDTextBlock" 
                   FontSize="16" 
                   HorizontalAlignment="Center" 
                   Margin="50,0,0,-10" Foreground="#333333"/>

        <TabControl>
            <!-- Вкладка Платежи -->
            <TabItem Header="Платежи">
                <StackPanel Margin="10">
                    <TextBlock Text="Список всех совершенных платежей" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="PaymentsListBox" Height="150">
                        <ListBoxItem Content="Оплата за семестр: 20000 рублей"/>
                        <ListBoxItem Content="Оплата за прогулы: 500 рублей"/>
                    </ListBox>
                    <Button Content="Узнать подробнее" 
                            Click="PaymentsDetailsButton_Click" 
                            Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка Долги -->
            <TabItem Header="Долги">
                <StackPanel Margin="10">
                    <TextBlock Text="Список долгов по дисциплинам" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="DebtsListBox" Height="150"/>
                    <Button Content="Узнать подробнее" 
                            Click="DebtsDetailsButton_Click" 
                            Margin="0,30,0,0"/>
                    <Button Content="Оплатить выбранный предмет"
                            Click="Pay_Item_Click"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка Система оплаты -->
            <TabItem Header="Система оплаты">
                <StackPanel Margin="10">
                    <TextBlock Text="Информация о системе оплаты" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Привязанные карты:" FontWeight="Bold" Margin="0,20,0,5"/>

                    <!-- Список карт -->
                    <ListBox x:Name="CardsListBox" Height="200" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#4CAF50" 
                                        CornerRadius="10" 
                                        Padding="10" 
                                        Margin="5"
                                        Width="250" 
                                        Height="80">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="Bold" 
                                                   Foreground="White" 
                                                   FontSize="14"/>
                                        <TextBlock Text="{Binding MaskedNumber}" 
                                                   Foreground="White" 
                                                   FontSize="16"/>
                                        <TextBlock TextAlignment="Right" Foreground="White" FontSize="12">
                                            <TextBlock.Inlines>
                                                <Run Text="Срок действия: " />
                                                <Run Text="{Binding Expiry}" FontWeight="Bold"/>
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Кнопки Привязать / Удалить -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Удалить выбранную карту"
                    Click="DeleteCard_Click"
                    Background="#f44336"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="220"
                    Height="35"
                    Margin="0,0,10,0"/>

                        <Button Content="Привязать карту" 
                    Click="BindCard_Click" 
                    Background="#4CAF50" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Width="220"
                    Height="35"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
