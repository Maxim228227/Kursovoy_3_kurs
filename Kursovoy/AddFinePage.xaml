<Page x:Class="Kursovoy.AddFinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавить штраф" Height="450" Width="650" Background="#F5F5F5">

    <Grid>
        <!-- Студент -->
        <Label Content="ID Студента:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="StudentIdTextBox" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="200"/>
        <Button Content="Список студентов" Margin="355,10,0,0" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ShowStudents_Click"/>

        <!-- Преподаватель -->
        <Label Content="ID Преподавателя:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TeacherIdTextBox" HorizontalAlignment="Left" Margin="150,40,0,0" VerticalAlignment="Top" Width="200"/>
        <Button Content="Список преподавателей" Margin="355,40,0,0" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ShowTeachers_Click"/>

        <!-- Стоимость -->
        <Label Content="ID Стоимости:" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="CostIdTextBox" HorizontalAlignment="Left" Margin="150,70,0,0" VerticalAlignment="Top" Width="200"/>
        <Button Content="Список стоимостей" Margin="355,70,0,0" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ShowCosts_Click"/>

        <!-- Предмет -->
        <Label Content="ID Предмета:" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="SubjectIdTextBox" HorizontalAlignment="Left" Margin="150,100,0,0" VerticalAlignment="Top" Width="200"/>
        <Button Content="Список предметов" Margin="355,100,0,0" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ShowSubjects_Click"/>

        <!-- Дата -->
        <Label Content="Дата (ГГ-ММ-ДД):" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="DateTextBox" HorizontalAlignment="Left" Margin="150,130,0,0" VerticalAlignment="Top" Width="200"/>

        <!-- Скидка -->
        <Label Content="Размер скидки:" HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="DiscauntTextBox" HorizontalAlignment="Left" Margin="150,160,0,0" VerticalAlignment="Top" Width="200"/>

        <Button Content="Добавить штраф" HorizontalAlignment="Left" Margin="150,190,0,0" VerticalAlignment="Top" Width="200" Click="AddFine_Click"/>
        <TextBlock x:Name="ResultTextBlock" Margin="10,200,0,0" Foreground="Green"/>

    </Grid>
</Page>